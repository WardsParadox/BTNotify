# Shared git-secrets rules, included explicitly by hk and mise tasks.
# Do not put actual credentials or broad allowlists in this file.
[secrets]
    patterns = (A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}
    patterns = "[\"']?(AWS|aws|Aws)?_?(SECRET|secret|Secret)_?(ACCESS|access|Access)?_?(KEY|key|Key)[\"']?[[:space:]]*(:|=>|=)[[:space:]]*[\"']?[A-Za-z0-9/+=]{40}"
    patterns = (gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,})
    patterns = -----BEGIN[[:space:]]((RSA|EC|DSA|OPENSSH|ENCRYPTED)[[:space:]])?PRIVATE[[:space:]]KEY-----
    patterns = xox[baprs]-[A-Za-z0-9-]{10,}
    patterns = AIza[A-Za-z0-9_-]{35}
    patterns = (sk|rk)_(live|test)_[A-Za-z0-9]{24,}
